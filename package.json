{
  "name": "gitleak-radar",
  "version": "1.2.0",
  "description": "Fast, local-first source code secret scanner and pre-commit gate CLI.",
  "keywords": [
    "security",
    "secret-scanner",
    "devsecops",
    "credentials",
    "pre-commit",
    "cli"
  ],
  "license": "GPL-3.0-or-later",
  "author": "gecekusu1979",
  "repository": {
    "type": "git",
    "url": "https://github.com/gecekusu1979/gitleak-radar.git"
  },
  "homepage": "https://github.com/gecekusu1979/gitleak-radar#readme",
  "bugs": {
    "url": "https://github.com/gecekusu1979/gitleak-radar/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "bin": {
    "gitleak-radar": "./dist/cli/index.js",
    "gitleak": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"try{fs.rmSync('dist',{recursive:true,force:true})}catch(e){}\"",
    "prepublishOnly": "pnpm typecheck && pnpm build && pnpm test"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "fast-glob": "^3.3.2",
    "ora": "^8.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.6"
  },
  "main": "./dist/scanner/scanner.js",
  "types": "./dist/scanner/scanner.d.ts",
  "exports": {
    ".": {
      "types": "./dist/scanner/scanner.d.ts",
      "import": "./dist/scanner/scanner.js"
    },
    "./sarif": {
      "types": "./dist/reporters/sarif.d.ts",
      "import": "./dist/reporters/sarif.js"
    }
  }
}
